def list_file(dp):
  fp_list = []
  for fp in os.listdir(dp):
    fp_list.append(os.path.join(dp, fp))
  fp_list.sort()
  return fp_list

def next_batch(num, data, labels):
  '''
  バッチ処理関数
  https://stackoverflow.com/questions/40994583/how-to-implement-tensorflows-next-batch-for-own-data/40995666
  Return a total of `num` random samples and labels. 
  '''
  idx = np.arange(0 , len(data))
  np.random.shuffle(idx)
  idx = idx[:num]
  data_shuffle = [data[ i] for i in idx]
  labels_shuffle = [labels[ i] for i in idx]

  return np.asarray(data_shuffle), np.asarray(labels_shuffle)

def learn_linear_transformation(source_vectors, target_vectors):
  # プレースホルダーの定義
  #source_ph = tf.compat.v1.placeholder(tf.float32, shape=[None, 10])
  #target_ph = tf.compat.v1.placeholder(tf.float32, shape=[None, 10])
  #mao修正
  # ベクトル空間次元数
  _, dvec_map_to = target_vectors.shape
  _, dvec_map_from = source_vectors.shape
  source_ph = tf.compat.v1.placeholder(tf.float32, shape=[None, dvec_map_from])
  target_ph = tf.compat.v1.placeholder(tf.float32, shape=[None, dvec_map_to])

  # 変換行列の定義
  #W = tf.Variable(tf.random.normal([10, 10]))
  #mao修正
  W = tf.Variable(tf.random.normal([dvec_map_from, dvec_map_to]))

  # 変換後のベクトル
  transformed_vectors = tf.matmul(source_ph, W)

  # 損失関数の定義（変換後のベクトルと目標ベクトルの間の二乗誤差）
  loss = tf.reduce_mean(tf.square(transformed_vectors - target_ph))

  # オプティマイザの定義
  optimizer = tf.compat.v1.train.AdamOptimizer(learning_rate=0.001)
  train_op = optimizer.minimize(loss)

  # セッションの設定
  init = tf.compat.v1.global_variables_initializer()

  with tf.compat.v1.Session() as sess:
    sess.run(init)
    #for epoch in range(1000000000):  # エポック数は1000から1000000000に調整
    for epoch in range(10000000):  # エポック数は1000から1000000000に調整
      _, loss_value = sess.run([train_op, loss], feed_dict={source_ph: source_vectors, target_ph: target_vectors})
      if epoch % 100 == 0:   # 100から10に変更
        print(f"Epoch: {epoch}, Loss: {loss_value}")

    # 訓練後の変換行列の取得
    W_val = sess.run(W)

  return W_val

def savepickle(lst, fp):
  with open(fp, 'wb') as f:
    pickle.dump(lst, f)

def loadpickle(fp):
  with open(fp, 'rb') as f:
    return pickle.load(f)

def cos_sim(v1, v2):
    return np.dot(v1, v2) / (np.linalg.norm(v1) * np.linalg.norm(v2))

